<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8"> <!-- Define a codificação de caracteres -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!-- Responsividade -->
    <title>Agrinho - Agro Forte e Sustentável</title> <!-- Título da aba do navegador -->
    <link rel="stylesheet" href="style.css"> <!-- Conecta o CSS externo -->
</head>
<body>

<header>
    <h1>🌱 Agrinho 2025</h1> <!-- Título principal -->
    <p>Agro Forte e Futuro Sustentável: equilíbrio entre produção agrícola e meio ambiente.</p> <!-- Subtítulo -->
</header>

<nav>
    <a href="#agro">Agro Forte</a>
    <a href="#sustentavel">Sustentabilidade</a>
    <a href="#equilibrio">Equilíbrio</a>
</nav>

<section id="agro">
    <h2>🚜 Agro Forte</h2>
    <p>Produção agrícola de qualidade, inovação e desenvolvimento rural.</p>
</section>

<section id="sustentavel">
    <h2>🌿 Futuro Sustentável</h2>
    <p>Preservação ambiental e uso consciente dos recursos naturais.</p>
</section>

<section id="equilibrio">
    <h2>⚖️ Equilíbrio entre Produção e Meio Ambiente</h2>
    <p>Tecnologias sustentáveis que permitem produzir mais e preservar o planeta.</p>
</section>

<section id="contador">
    <h2>🌳 Árvores Preservadas</h2>
    <div id="numero">0</div> <!-- Número animado pelo JS -->
    <button onclick="iniciarContador()">Mostrar Impacto Positivo</button> <!-- Botão que chama função JS -->
</section>

<footer>
    <p>Projeto Agrinho - Agro Forte e Futuro Sustentável 🌱</p>
</footer>

<script src="script.js"></script> <!-- Conecta o JS externo -->
</body>
</html>
/* Reset básico */
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family: Arial, sans-serif;
}

/* Corpo da página */
body{
    background:#f4f9f4; /* cor de fundo clara */
    color:#333; /* cor do texto */
}

/* Cabeçalho */
header{
    background: linear-gradient(135deg,#2e7d32,#66bb6a); /* degradê verde */
    color:white;
    text-align:center;
    padding:80px 20px;
}

header h1{
    font-size:3rem;
    margin-bottom:15px;
}

header p{
    font-size:1.2rem;
}

/* Navegação */
nav{
    background:#1b5e20;
    padding:15px;
    text-align:center;
    position:sticky; /* fica no topo ao rolar */
    top:0;
}

nav a{
    color:white;
    text-decoration:none;
    margin:0 15px;
    font-weight:bold;
}

/* Seções */
section{
    padding:60px 10%;
}

/* Números animados */
#contador{
    text-align:center;
    background:#e8f5e9;
    padding:50px;
}

#numero{
    font-size:4rem;
    color:#2e7d32;
    font-weight:bold;
    margin-top:20px;
}

/* Botão */
button{
    background:#2e7d32;
    color:white;
    border:none;
    padding:12px 25px;
    border-radius:8px;
    cursor:pointer;
    margin-top:20px;
}

button:hover{
    background:#1b5e20;
}

/* Rodapé */
footer{
    background:#1b5e20;
    color:white;
    text-align:center;
    padding:25px;
}

/* Responsividade */
@media(max-width:768px){
    header h1{
        font-size:2rem;
    }
}
function iniciarContador() {
    let numero = 0; // Começa em 0
    const alvo = 1000; // Número final desejado

    const contador = setInterval(() => {
        numero += 10; // Aumenta de 10 em 10
        document.getElementById("numero").textContent = numero; // Atualiza o HTML

        if(numero >= alvo){ // Para quando chega ao alvo
            clearInterval(contador);
        }
    }, 20); // Intervalo de 20ms entre cada incremento
}
